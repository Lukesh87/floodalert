# =================================================================
# URBAN FLOOD NOWCASTING SYSTEM - ENVIRONMENT CONFIGURATION
# Location Focus: Coimbatore, Tamil Nadu, India (11.0168° N, 76.9558° E)
# =================================================================

# Application Mode & Security
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-urban-flood-nowcasting-coimbatore-2026
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Database Configuration
# Default: SQLite (portable, zero-setup for local development)
DATABASE_URL=sqlite:///./urban_flood.db
# PostgreSQL + PostGIS (Production/Docker deployment):
# DATABASE_URL=postgresql+psycopg2://flood_admin:flood_secure_pass@localhost:5432/flood_db

# Weather & Nowcasting API Providers
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_TTL_SECONDS=900

# Real-Time Weather API Keys (Backend)
# Optional: Set your OpenWeatherMap or WeatherAPI key to pull authenticated live telemetry.
# If left empty, system automatically uses Open-Meteo high-resolution numerical model.
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=
WEATHER_PROVIDER=auto

# Machine Learning Pipeline
ML_MODEL_PATH=./app/ml/artifacts/random_forest_flood_model.joblib
ML_METRICS_PATH=./app/ml/artifacts/model_metrics.json

# Alert System Configuration
ALERT_COOLDOWN_MINUTES=60
ALERT_EXPIRY_HOURS=6
EMAIL_NOTIFICATIONS_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMERGENCY_DESK_EMAIL=disaster-response@cbmc.tn.gov.in

# Real-Time Map Providers & API Keys (Frontend)
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=
VITE_OPENWEATHERMAP_API_KEY=

