# =================================================================
# URBAN FLOOD NOWCASTING - FRONTEND CONFIGURATION
# =================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Real-Time Map Providers & API Keys
# Google Maps API Key:
# Optional: The app already defaults to real-time Google Maps Hybrid, Satellite & Terrain tiles.
# Enter your Google Cloud API key if you want direct dedicated quota / services:
VITE_GOOGLE_MAPS_API_KEY=

# Mapbox Access Token (Optional, for Mapbox Dark & Satellite vector tiles):
VITE_MAPBOX_ACCESS_TOKEN=

# OpenWeatherMap API Key (Optional, for live precipitation radar layer):
VITE_OPENWEATHERMAP_API_KEY=
